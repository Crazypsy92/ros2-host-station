<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mujoco_bridge</name>
  <version>1.0.0</version>
  <description>ROS 2 Bridge for MuJoCo physics simulation and virtual arm dynamics (MuJoCo 仿真桥接节点)</description>
  <maintainer email="bridge@local.dev">Bridge</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>host_interfaces</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
